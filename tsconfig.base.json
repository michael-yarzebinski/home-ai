{
  "compilerOptions": {
    "lib": ["ES2021", "dom"],
    "module": "commonjs",
    "target": "ES2021",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "composite": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@home-ai/shared/*": ["apps/shared/src/*"],
    }
  }
}
