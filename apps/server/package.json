{
  "name": "@home-ai/server",
  "version": "1.0.0",
  "description": "NestJS backend for the private local AI home assistant",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist && npm run build-shared",
    "build-shared": "npm run build --prefix ../shared",
    "start": "npm run build:shared && npm run build && npm run migration:run && node dist/main",
    "start:dev": "npm run migration:run && nest start --watch",
    "start:debug": "npm run migration:run && nest start --debug --watch",
    "start:prod": "npm run migration:run && node dist/main",
    "build": "nest build",
    "build:docker": "nest build",
    "build:shared": "npm run build --workspace=@home-ai/shared",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "migration:generate": "knex migrate:make -x ts",
    "migration:run": "knex migrate:latest",
    "migration:rollback": "knex migrate:rollback",
    "seed:run": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "db:status": "knex migrate:status"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@home-ai/shared": "*",
    "@modelcontextprotocol/client": "^2.0.0-alpha.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@mozilla/readability": "^0.6.0",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "class-validator-jsonschema": "^5.1.0",
    "dotenv": "^16.4.5",
    "home-assistant-js-websocket": "^9.6.0",
    "ioredis": "^5.10.1",
    "jsdom": "^29.0.2",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "nestjs-cls": "^6.2.0",
    "ollama": "^0.6.3",
    "openai": "^6.34.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "puppeteer": "^24.41.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/testing": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/lodash": "^4.17.24",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.3.0",
    "rimraf": "^6.1.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
