# =============================================================================
# Database
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=aiadmin
DB_PASSWORD=aihome_secure_2026
DB_NAME=aihome

# =============================================================================
# Server
# =============================================================================
SERVER_PORT=3000
NODE_ENV=development
PLATFORM=windows

# Web UI / API sessions (set JWT_SECRET in production)
JWT_SECRET=change_this_jwt_secret_in_production
JWT_EXPIRES_IN=8h
# Comma-separated fact keys exposed on GET /api/status/summary (optional)
STATUS_PUBLIC_FACT_KEYS=

# =============================================================================
# AI Configuration (Local vs Cloud)
# =============================================================================
# Choose between local Ollama (recommended for privacy & accuracy) or cloud
AI_PROVIDER=local                    # Options: local | cloud

# -------------------------- Local Ollama Settings --------------------------
LOCAL_AI_URL=http://localhost:11434/api/generate
LOCAL_MODEL=qwen2.5:7b               # Recommended: qwen2.5:7b or qwen3:8b

# -------------------------- Cloud AI Settings (when AI_PROVIDER=cloud) -----
CLOUD_AI_URL=https://api.openai.com/v1/chat/completions
CLOUD_AI_API_KEY=sk-...              # Your cloud provider API key
CLOUD_MODEL=gpt-4o-mini              # Examples: gpt-4o-mini, grok-beta, claude-3-5-sonnet-20241022

# Shared AI settings
AI_TEMPERATURE=0.0                   # 0.0 = most deterministic (recommended)

# =============================================================================
# Webhook & Messaging
# =============================================================================
WEBHOOK_SECRET=change_this_to_a_strong_secret_please

# BlueBubbles (iMessage) webhook - usually handled by BlueBubbles itself
# Your NestJS webhook endpoint will be: http://your-mac-mini-ip:3000/webhook/imessage

# =============================================================================
# Home Assistant Integration
# =============================================================================
HA_URL=http://localhost:8123         # URL to your Home Assistant instance
HA_LONG_LIVED_TOKEN=eyJ...           # Long-lived access token from HA UI

# =============================================================================
# Other Features
# =============================================================================
WEATHER_ZIP_CODE=90210               # Used for daily summaries if enabled

# Optional: Quiet hours defaults (can be overridden per user)
DEFAULT_QUIET_START=22:00
DEFAULT_QUIET_END=08:00