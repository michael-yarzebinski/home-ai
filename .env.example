# =============================================================================
# home-ai — environment variables used by apps/server
#
# Loaded via @nestjs/config from the repo-root .env (see apps/server/src/
# app.module.ts: envFilePath: '../../.env' when running from apps/server).
# Knex CLI (migrations) reads the same keys from the environment via
# apps/server/knexfile.ts (defaults apply only there, not in Nest CoreModule).
# =============================================================================

# -----------------------------------------------------------------------------
# Server (apps/server/src/main.ts)
# -----------------------------------------------------------------------------
# TCP port for the Nest HTTP server. Defaults to 3000 if unset.
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL — required at runtime for Nest (apps/server/src/core/core.module.ts)
# Optional defaults when running Knex only (apps/server/knexfile.ts)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=homeaiadmin
DB_PASSWORD=homeaiadmin_secure_2026
DB_NAME=aihome

# -----------------------------------------------------------------------------
# AI provider selection (apps/server/src/ai/ai.module.ts)
# -----------------------------------------------------------------------------
# Which LLM implementation to register: "local" (Ollama) or "cloud" (OpenAI-compatible API).
AI_PROVIDER=local

# --- Local Ollama (apps/server/src/ai/local/local-llm.service.ts) ---
# Ollama server base URL (passed to the Ollama client as `host`), e.g. http://127.0.0.1:11434
LOCAL_AI_HOST=http://127.0.0.1:11434
# Model name as known to Ollama (e.g. qwen2.5:7b).
LOCAL_AI_MODEL=qwen2.5:7b

# --- Cloud / OpenAI-compatible (apps/server/src/ai/cloud/cloud-llm.service.ts) ---
# Used when AI_PROVIDER=cloud. API key for the provider.
CLOUD_LLM_API_KEY=ADD_YOUR_KEY_HERE_IF_YOU_HAVE_ONE
# Base URL for the OpenAI-compatible HTTP API (e.g. https://api.openai.com/v1 or a proxy).
CLOUD_LLM_URL=https://api.openai.com/v1
# Chat model id for completions (e.g. gpt-4o-mini).
CLOUD_LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Home Assistant (apps/server/src/integrations/home-assistant/home-assistant.service.ts)
# -----------------------------------------------------------------------------
# Internal user id (UUID in your DB) whose context is used for HA-driven automations/events.
AUTOMATION_USER_ID='11111111-1111-1111-1111-111111111111'
# Home Assistant URL for WebSocket auth (http(s) or ws(s); normalized internally for token auth).
HOME_ASSISTANT_URL=http://localhost:8123
# Long-lived access token from Home Assistant (Profile → Long-Lived Access Tokens).
HOME_ASSISTANT_TOKEN=RUN_SETUP.SH

# -----------------------------------------------------------------------------
# BlueBubbles (iMessage bridge) (apps/server/src/integrations/blue-bubbles/blue-bubbles.service.ts)
# -----------------------------------------------------------------------------
# Private API base URL for your BlueBubbles server (no trailing slash unless your client expects it).
BLUEBUBBLES_URL=http://localhost:1234
# BlueBubbles server / private API password.
BLUEBUBBLES_PASSWORD=RUN_SETUP.SH

# -----------------------------------------------------------------------------
# Recipe saver / attachments (apps/server/src/features/recipe-saver/tools/scrape-recipe.tool.ts)
# -----------------------------------------------------------------------------
# Absolute or relative path where scraped recipe PDFs are stored (subfolder recipes/ is created).
ATTACHMENTS_DIRECTORY=./attachments
