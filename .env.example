# =============================================================================
# home-ai - environment variables used by apps/server
# =============================================================================

PORT=3000

# -----------------------------------------------------------------------------
# Auth (required — Nest JWT module fails fast if unset)
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# -----------------------------------------------------------------------------
# PostgreSQL - required at runtime for Nest
# `postgres` = Docker Compose service name (API container → DB). `localhost` = host dev.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=homeaiadmin
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=aihome

# -----------------------------------------------------------------------------
# AI Related Settings:
# Configurations are required for SOON and IMMEDIATE.
# CLIENT_TYPE: gemini | openai | ollama
# OpenAI client also works with Nvidia and Groq-compatible endpoints.
#
# Mac Mini hub: Ollama runs on the host (Metal). The Nest container reaches it
# via host.docker.internal. Linux Compose profile (`linux-ollama`) should use
# http://ollama:11434/v1 instead.
# -----------------------------------------------------------------------------

# Configuration for IMMEDIATE (live chat, iMessage, fast-path devices)
IMMEDIATE_CLIENT_TYPE=ollama
IMMEDIATE_MODEL_NAME=qwen3:8b
IMMEDIATE_BASE_URL=http://host.docker.internal:11434/v1

# Configuration for SOON (background automations)
SOON_CLIENT_TYPE=ollama
SOON_MODEL_NAME=qwen3:8b
SOON_BASE_URL=http://host.docker.internal:11434/v1

# Vision / camera classification (pulled by install.sh; not wired into orchestration yet)
# OLLAMA_VISION_MODEL=qwen3-vl:8b

# Cloud alternatives:
## IMMEDIATE_CLIENT_TYPE=gemini
## IMMEDIATE_MODEL_NAME=gemini-2.5-flash
## IMMEDIATE_API_KEY=ADD_YOUR_IMMEDIATE_API_KEY_HERE
## IMMEDIATE_BASE_URL=https://generativelanguage.googleapis.com/v1/
## -----------------------------------------------------------------------------
## SOON_CLIENT_TYPE=openai
## SOON_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b
## SOON_API_KEY=ADD_YOUR_SOON_API_KEY_HERE
## SOON_BASE_URL=https://integrate.api.nvidia.com/v1
## -----------------------------------------------------------------------------
## SOON_CLIENT_TYPE=openai
## SOON_MODEL_NAME=llama-3.3-70b-versatile
## SOON_BASE_URL=https://api.groq.com/openai/v1
## SOON_API_KEY=ADD_YOUR_GROQ_API_KEY_HERE

# -----------------------------------------------------------------------------
# Home Assistant (apps/server/src/integrations/home-assistant/home-assistant.service.ts)
# -----------------------------------------------------------------------------
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=ADD_YOUR_HOME_ASSISTANT_TOKEN_HERE

# -----------------------------------------------------------------------------
# BlueBubbles (iMessage bridge) (apps/server/src/integrations/blue-bubbles/blue-bubbles.service.ts)
# -----------------------------------------------------------------------------
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=CHANGE_ME_BLUEBUBBLES_PASSWORD

# -----------------------------------------------------------------------------
# Additional Home AI Settings
# -----------------------------------------------------------------------------
ATTACHMENTS_DIRECTORY=../../attachments
CONVERSATION_SESSION_TIMEOUT_MS=7200000
AUTOMATION_USER_ID='11111111-1111-1111-1111-111111111111'
